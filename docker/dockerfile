# =========================================================================
# STAGE 1: The Builder
# - OpenCV, libcamera, rpicam-apps, kmsxx 소스 코드를 컴파일하고 빌드합니다.
# - Rust 개발 환경과 모든 개발용 도구(-dev 패키지 등)를 설치합니다.
# =========================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /usr/src

# 1. 모든 시스템 의존성 패키지를 한 번에 설치합니다.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git g++ cmake ninja-build curl wget tar pkg-config \
    python3 python3-dev python3-pip python3-jinja2 python3-yaml python3-ply libyaml-dev python3-numpy \
    clang libclang-dev libevent-dev libevent-pthreads-2.1-7 \
    libgtk-3-dev libjpeg-dev libpng-dev libtiff-dev \
    libavcodec-dev libavformat-dev libswscale-dev libv4l-dev libxine2-dev \
    libepoxy-dev libboost-dev libgnutls28-dev openssl pybind11-dev \
    liblttng-ust-dev libglib2.0-dev libgstreamer-plugins-base1.0-dev \
    libboost-program-options-dev libdrm-dev libexif-dev libfmt-dev libavfilter-dev libavdevice-dev \
    libcap-dev libsdl2-dev libyuv-dev curl \
    # Qt6 (qcam 빌드를 위해 필요)
    qt6-base-dev qt6-base-dev-tools libqt6opengl6-dev \
    libgl1-mesa-dev libgles2-mesa-dev libegl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# ⚠️ 중요: apt의 libcamera-dev는 헤더 충돌을 일으키므로 설치하지 않습니다.

# 2. 최신 Meson 및 Rust를 설치합니다.
# 기존: RUN pip3 install --no-cache-dir meson
RUN apt-get update && apt-get install -y --no-install-recommends meson && rm -rf /var/lib/apt/lists/*

# pip가 PEP 668로 막히지 않도록 전역 허용
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.local/bin:/root/.cargo/bin:${PATH}"

# (선택) Qt6 pkg-config 경로 — noble에선 보통 불필요하지만 남겨둠. x86_64면 aarch64 대신 x86_64 사용
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/qt6/pkgconfig:/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/lib/pkgconfig

# 3. OpenCV 4.11.0을 빌드하고 설치합니다.
RUN wget -O opencv.tar.gz https://github.com/opencv/opencv/archive/4.11.0.tar.gz && \
    tar -xf opencv.tar.gz && \
    wget -O opencv_contrib.tar.gz https://github.com/opencv/opencv_contrib/archive/4.11.0.tar.gz && \
    tar -xf opencv_contrib.tar.gz && \
    cd opencv-4.11.0 && mkdir build && cd build && \
    cmake -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D CMAKE_BUILD_TYPE=Release \
      -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib-4.11.0/modules \
      -D BUILD_EXAMPLES=OFF -D BUILD_TESTS=OFF -D BUILD_PERF_TESTS=OFF \
      -D OPENCV_GENERATE_PKGCONFIG=ON \
      -D WITH_OPENCL=ON \
      -D ENABLE_NEON=ON \
          -D CMAKE_C_FLAGS:STRING="-O3 -pipe -march=armv8-a" \
          -D CMAKE_CXX_FLAGS:STRING="-O3 -pipe -march=armv8-a" \
          .. && \
    make -j"$(nproc)" && make install && \
    cd /usr/src && rm -rf opencv*



# 4. libcamera를 빌드하고 설치합니다.
#  - RPi fork의 next 브랜치를 사용하여 rpicam-apps 최신 API와 호환되게 합니다.
#  - /usr/local 에 설치되므로 pkg-config 및 런타임 경로를 /usr/local 우선으로 설정합니다.
RUN git clone --depth=1 -b next https://github.com/raspberrypi/libcamera.git && \
    cd libcamera && \
    meson setup build --buildtype=release \
      -Dpipelines=rpi/vc4,rpi/pisp -Dipas=rpi/vc4,rpi/pisp \
      -Dv4l2=enabled -Dgstreamer=enabled -Dtest=false -Dlc-compliance=enabled \
      -Dcam=enabled -Dqcam=enabled -Ddocumentation=disabled -Dpycamera=enabled && \
    ninja -C build -j"$(nproc)" && \
    meson install -C build && \
    ldconfig

# /usr/local 우선 검색되도록 환경 설정 (빌드와 런타임 모두에 유리)
ENV PKG_CONFIG_PATH=/usr/local/lib/aarch64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig:/usr/lib/aarch64-linux-gnu/qt6/pkgconfig:/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/lib/pkgconfig
ENV LD_LIBRARY_PATH=/usr/local/lib/aarch64-linux-gnu:/usr/local/lib:$LD_LIBRARY_PATH

# 5. rpicam-apps를 빌드하고 설치합니다.
RUN git clone https://github.com/raspberrypi/rpicam-apps.git && \
    cd rpicam-apps && \
    meson setup build -Denable_libav=disabled -Denable_drm=enabled -Denable_egl=disabled -Denable_qt=enabled -Denable_opencv=disabled -Denable_tflite=disabled && \
    ninja -C build -j"$(nproc)" && \
    meson install -C build && \
    ldconfig

# 6. kmsxx를 빌드하고 설치합니다.
RUN git clone https://github.com/tomba/kmsxx.git && \
    cd kmsxx && \
    git submodule update --init && \
    meson build -Dpykms=enabled && \
    ninja -C build -j"$(nproc)" && \
    ninja -C build install && \
    ldconfig

# 7. Python 패키지를 빌더 스테이지에서 설치합니다. (컴파일러가 여기에 있으므로)
RUN pip3 install --no-cache-dir picamera2 simplejpeg Adafruit-Blinka adafruit-circuitpython-pca9685

# =========================================================================
# STAGE 2: The Final Image
# - 최종 실행 환경으로, 빌드 단계에서 생성된 결과물과 Rust만 가져옵니다.
# - 개발 도구가 제거된 가볍고 깨끗한 이미지가 만들어집니다.
# =========================================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. 실행에 필요한 최소한의 런타임 라이브러리와 LLVM 17을 설치합니다.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 기존 의존성 패키지들
    python3 python3-pip python3-numpy \
    libgtk-3-0 libjpeg-turbo8 libpng16-16 libtiff6 \
    libavcodec60 libavformat60 libswscale7 libv4l-0 libxine2 \
    libepoxy0 libboost-program-options1.83.0 libgnutls30 liblttng-ust1 \
    libglib2.0-0 libgstreamer-plugins-base1.0-0 \
    libdrm2 libexif12 libfmt-dev libavfilter9 libavdevice60 \
    libcap2 curl libevent-dev libevent-pthreads-2.1-7 \
    libqt6core6 libqt6gui6 libqt6widgets6 libqt6opengl6 python3-libcamera \
    # 아이폰 Tcp 스트리밍용
    usbmuxd libimobiledevice6 libimobiledevice-utils \
    # SDL2 런타임
    libsdl2-2.0-0 \
    # 그래픽/GL
    libgl1-mesa-dri libgl1 libgles2 libegl1 \
    # LLVM 저장소 추가에 필요한 패키지
    wget gpg ca-certificates software-properties-common \
    && \
    # LLVM 17 공식 저장소 추가 (noble)
    wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm-snapshot.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/llvm-snapshot.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-17 main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get update && \
    # LLVM 17 및 Clang 17 관련 패키지 설치
    apt-get install -y --no-install-recommends \
    llvm-17 llvm-17-dev clang-17 libclang-17-dev \
    # Rust로 C 링킹을 하려면 빌드 도구가 어느 정도 필요
    git libsdl2-dev build-essential pkg-config vim libwebp-dev python3-dev git \
    && rm -rf /var/lib/apt/lists/*

# 2. Rust가 LLVM 17을 사용하도록 환경 변수를 설정합니다.
ENV LLVM_CONFIG_PATH=/usr/bin/llvm-config-17
ENV LIBCLANG_PATH=/usr/lib/llvm-17/lib

# 3. 최종 이미지에 Rust 환경을 설치합니다. (이제 시스템 LLVM 17을 사용)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 4. Builder 스테이지에서 빌드된 모든 라이브러리(OpenCV, libcamera 등)를 복사합니다.
COPY --from=builder /usr/local /usr/local

# 5. Builder에서 설치된 Python 패키지 복사
COPY --from=builder /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages

# 6. 공유 라이브러리 캐시를 업데이트합니다.
RUN ldconfig

# ... 앞부분 생략
ENV PYTHONPATH="/usr/lib/aarch64-linux-gnu/python3.12/site-packages:/usr/local/lib/aarch64-linux-gnu/python3.12/site-packages:${PYTHONPATH}"
ENV LIBCAMERA_IPA_PATH="/usr/local/lib/aarch64-linux-gnu/libcamera"


WORKDIR /rust_ws
CMD ["/bin/bash"]

# zsh :
